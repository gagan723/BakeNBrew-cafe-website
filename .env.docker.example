# Copy to .env.docker and replace the required values.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-jwt-secret
CHAT_CONFIRMATION_SECRET=replace-with-a-different-long-random-secret
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Leave unset to use the bundled MongoDB container.
# MONGO_URL=mongodb+srv://user:password@cluster.example.mongodb.net/bakenbrew

FRONTEND_PORT=5173
BACKEND_PORT=8000
MCP_PORT=8001
MONGO_PORT=27017
VITE_API_URL=http://localhost:8000

# Optional; needed only for admin image uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
